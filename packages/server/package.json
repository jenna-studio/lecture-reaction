{
  "name": "@lr/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "simulate": "node test/simulate-class.mjs",
    "test:lan": "node --experimental-strip-types test/lan.mjs"
  },
  "dependencies": {
    "@lr/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
